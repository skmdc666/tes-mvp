{
  "name": "tes-mvp",
  "version": "1.0.0",
  "description": "TES MVP Backend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "echo 'No build step required for Railway'",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:migrate": "docker-compose -f docker-compose.dev.yml exec -T app npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "echo 'No tests yet'",
    "test:setup": "node test/setup-test-env.js",
    "test:basic": "node test/api-test.js",
    "test:stress": "node test/stress-test.js",
    "test:integration": "tsx test/integration.test.ts",
    "test:all": "npm run test:setup && npm run test:basic && npm run test:stress && npm run test:integration",
    "test:watch": "nodemon --watch test --ext js,ts test/api-test.js",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker-compose -f docker-compose.dev.yml up --build -d",
    "docker:prod": "docker-compose up --build",
    "docker:prod:detached": "docker-compose up --build -d",
    "docker:stop": "docker-compose down",
    "docker:stop:dev": "docker-compose -f docker-compose.dev.yml down",
    "start:dev": "./scripts/start-dev.sh",
    "stop:dev": "./scripts/stop-dev.sh",
    "db:reset": "docker-compose -f docker-compose.dev.yml exec -T psql -U tes_user_dev -d tes_mvp_dev -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\"",
    "db:seed:dev": "docker-compose -f docker-compose.dev.yml exec -T app npm run db:seed",
    "db:setup:dev": "docker-compose -f docker-compose.dev.yml exec -T app npm run db:setup"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^1.4.0",
    "helmet": "^7.1.0",
    "node-cache": "^5.1.2",
    "pg": "^8.11.3",
    "socket.io": "^4.8.3",
    "sql-template-strings": "^2.2.2",
    "tsx": "^4.6.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "@types/supertest": "^2.0.12",
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
