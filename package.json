{
  "name": "tes-mvp",
  "version": "1.0.0",
  "description": "TES MVP Backend API",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "echo 'No build step required for Railway'",
    "test": "echo 'No tests yet'",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker-compose -f docker-compose.dev.yml up --build -d",
    "docker:prod": "docker-compose up --build",
    "docker:prod:detached": "docker-compose up --build -d",
    "docker:stop": "docker-compose down",
    "docker:stop:dev": "docker-compose -f docker-compose.dev.yml down",
    "start:dev": "./scripts/start-dev.sh",
    "stop:dev": "./scripts/stop-dev.sh",
    "db:migrate": "docker-compose -f docker-compose.dev.yml exec -T app npm run migrate",
    "db:reset": "docker-compose -f docker-compose.dev.yml exec -T psql -U tes_user_dev -d tes_mvp_dev -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}